{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a034f524-ba00-41d1-b51a-10d4bed30fb3","database_name": "web-app-nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c7519a2e6dbf4bb0a63c3b04640dac7d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
